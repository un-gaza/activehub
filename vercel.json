{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "version":2,
  "regions":["fra1"],
  "buildCommand":"node --check server.mjs && node --check public/app.js",
  "outputDirectory":"public",
  "functions":{"api/index.mjs":{"maxDuration":60,"includeFiles":"db/schema.sql"}},
  "rewrites":[{"source":"/api/:path*","destination":"/api/index?_route=:path*"},{"source":"/admin","destination":"/index.html"}],
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"same-origin"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}]}]
}
